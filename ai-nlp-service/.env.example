# ==============================================================================
# AI Talent Screening Platform — Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in this directory:
#      copy .env.example .env
# 2. Paste your MongoDB Atlas URI and Elasticsearch URL below.
# 3. If left blank or unset, the service automatically uses thread-safe in-memory
#    resilient fallbacks with pre-seeded talent candidates.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Configuration (Operational Document Store / Source of Truth)
# ------------------------------------------------------------------------------
# For MongoDB Atlas (Free Tier M0):
#   - Sign up at https://cloud.mongodb.com
#   - Create database user under 'Database Access'
#   - Allow access from anywhere (0.0.0.0/0) under 'Network Access'
#   - Click 'Connect' -> 'Drivers' (Python) and copy your SRV connection string:
#
# Format: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=resume_screening_db

# ------------------------------------------------------------------------------
# 2. Elasticsearch Configuration (Vector & BM25 Hybrid Search Engine)
# ------------------------------------------------------------------------------
# Option A: Elastic Cloud (https://cloud.elastic.co)
#   - Set ELASTICSEARCH_URL to your deployment endpoint
#   - Set ELASTIC_USER (usually 'elastic') and ELASTIC_PASSWORD
#
# Option B: Bonsai.io (https://bonsai.io)
#   - One-click Elasticsearch instance. Provides full URL with credentials:
#   - Example: https://key:secret@my-cluster.bonsai.io
#
# Option C: Local Elasticsearch Docker / Host
#   - Default: http://localhost:9200
ELASTICSEARCH_URL=http://localhost:9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=password123
ELASTIC_INDEX=resumes-vector-idx

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
